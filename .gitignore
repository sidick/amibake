__pycache__/
*.pyc
.venv/
dist/
build/
*.egg-info/
.pytest_cache/
.ruff_cache/

# User-supplied proprietary media/ROMs — never committed (licensing hygiene).
assets/

# Image-sized build outputs never enter the repo.
*.hdf
*.adf

# Generated lockfiles: `amibake resolve` writes <manifest>.lock.toml
# beside its manifest, so these land in manifests/ during ordinary use.
*.lock.toml

# The rest of what `amibake build` drops beside a manifest when given no
# --out: emitted emulator configs (host-absolute ROM and volume paths,
# meaningless on anyone else's machine) and the `dir` output tree. A dir
# tree from a proprietary base is that base's media re-committed by
# another route — manifests/os314/ was 784 files of real AmigaOS 3.1.4 —
# which is the same licensing line assets/ exists to hold.
*-amiberry.uae
*-winuae.uae
*.copperline.toml
manifests/*/

# amibake build's default layer/archive cache root.
.amibake-cache/

# Scratch home for local `amibake build --out` trees, lockfiles and
# emitted emulator configs — build output never belongs in manifests/.
.amibake-out/

# MkDocs local build output (mkdocs.yml + .github/workflows/docs.yml).
site/
