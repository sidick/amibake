__pycache__/
*.pyc
.venv/
dist/
build/
*.egg-info/
.pytest_cache/
.ruff_cache/

# User-supplied proprietary media/ROMs — never committed (licensing hygiene).
assets/

# Image-sized build outputs never enter the repo.
*.hdf
*.adf

# amibake build's default layer/archive cache root.
.amibake-cache/

# Scratch home for local `amibake build --out` trees, lockfiles and
# emitted emulator configs — build output never belongs in manifests/.
.amibake-out/

# MkDocs local build output (mkdocs.yml + .github/workflows/docs.yml).
site/
